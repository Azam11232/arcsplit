# Copy this file to .env and fill in values.
# Never commit .env -- it is listed in .gitignore.

# ── ArcSplit contract ─────────────────────────────────────────────────────────
# Address of the deployed ArcSplit contract on Arc Mainnet.
VITE_ARCSPLIT_ADDRESS=0xB7Ee9d819AA626F3ABA56ab3948bC56fa62f0E7E

# Optional Testnet deployment. Defaults to the existing deployed contract.
# VITE_ARCSPLIT_TESTNET_ADDRESS=0xd90b75d07a2b592b0a01f0ac63d522f54ffd1ef2

# ── Re-deploy via Circle Smart Contract Platform (optional) ───────────────────
# Only needed if you run bun run deploy:self to re-deploy the contract.
# Obtain keys from https://console.circle.com -- never commit real values here.
# CIRCLE_API_KEY=
# CIRCLE_ENTITY_SECRET=
