# Copy this file to .env and fill in values.
# Never commit .env -- it is listed in .gitignore.

# ── ArcSplit contract ─────────────────────────────────────────────────────────
# Address of the deployed ArcSplit contract on Arc Mainnet.
VITE_ARCSPLIT_ADDRESS=0xB7Ee9d819AA626F3ABA56ab3948bC56fa62f0E7E

# Next Mainnet deployment. Analytics scans this and the historical contracts.
VITE_ARCSPLIT_MAINNET_NEXT_ADDRESS=0xF13199D9bbf965eE10f41b531Ee4aa660bB54738

# Activate the verified next Mainnet contract as the transaction and approval target.
VITE_ARCSPLIT_MAINNET_USE_NEXT_ADDRESS=true

# Arc Testnet transaction target.
VITE_ARCSPLIT_TESTNET_ADDRESS=0x0c4DC391c39641B5DEa9304454B99B37c9FFFb35

# ── Re-deploy via Circle Smart Contract Platform (optional) ───────────────────
# Only needed if you run bun run deploy:self to re-deploy the contract.
# Obtain keys from https://console.circle.com -- never commit real values here.
# CIRCLE_API_KEY=
# CIRCLE_ENTITY_SECRET=
